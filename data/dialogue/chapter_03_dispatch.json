{
  "conversations": {
    "intro": [
      {
        "speaker": "旁白",
        "text": "调度室面向山路。雨云正在退去，十二年前的四份时间记录第一次被摊在同一张桌上。",
        "voice": "res://assets/audio/dialogue/chapter_03/narrator/chapter_03_dispatch_intro_00.wav",
        "voice_bus": "Voice"
      },
      {
        "speaker": "邓守义",
        "text": "我一直说车是四点十七分开的。可这张打孔纸不是我今天才想起来的。",
        "voice": "res://assets/audio/dialogue/chapter_03/deng_shouyi/chapter_03_dispatch_intro_01.wav",
        "voice_bus": "Voice"
      },
      {
        "speaker": "黄维国",
        "text": "几只坏钟不等于旧案全错。陈默进了售票室，余真带走了邮袋，这两件事都是真的。",
        "voice": "res://assets/audio/dialogue/chapter_03/huang_weiguo/chapter_03_dispatch_intro_02.wav",
        "voice_bus": "Voice"
      },
      {
        "speaker": "侦探",
        "text": "真话之间也能塞进错误的因果。先把时间还原。",
        "voice": "res://assets/audio/dialogue/chapter_03/detective/chapter_03_dispatch_intro_03.wav",
        "voice_bus": "Voice"
      }
    ],
    "route_first": [
      {
        "speaker": "邓守义",
        "text": "打孔轮每天由收费站封签。我接到塌方预警，三点五十二分就开了维护车。",
        "voice": "res://assets/audio/dialogue/chapter_03/deng_shouyi/chapter_03_dispatch_route_first_00.wav",
        "voice_bus": "Voice"
      },
      {
        "speaker": "侦探",
        "text": "它不接站里的电，也没有在复电后被拨动。这是第一枚独立锚点。",
        "voice": "res://assets/audio/dialogue/chapter_03/detective/chapter_03_dispatch_route_first_01.wav",
        "voice_bus": "Voice"
      },
      {
        "speaker": "邓守义",
        "text": "余真没上车。我怕承认提前发车担责任，就顺着他们说成了四点十七分。",
        "voice": "res://assets/audio/dialogue/chapter_03/deng_shouyi/chapter_03_dispatch_route_first_02.wav",
        "voice_bus": "Voice"
      }
    ],
    "route_repeat": [
      {
        "speaker": "侦探",
        "text": "03:52，维护车已经离站。旧案的统一时间连发车都解释不了。",
        "voice": "res://assets/audio/dialogue/chapter_03/detective/chapter_03_dispatch_route_repeat_00.wav",
        "voice_bus": "Voice"
      }
    ],
    "questions_first": [
      {
        "speaker": "侦探",
        "text": "黄维国的原始速记不是问‘几点’，而是问‘你在四点十七分看见了什么’。",
        "voice": "res://assets/audio/dialogue/chapter_03/detective/chapter_03_dispatch_questions_first_00.wav",
        "voice_bus": "Voice"
      },
      {
        "speaker": "黄维国",
        "text": "所有钟都那么显示，我当然按那个时间问。",
        "voice": "res://assets/audio/dialogue/chapter_03/huang_weiguo/chapter_03_dispatch_questions_first_01.wav",
        "voice_bus": "Voice"
      },
      {
        "speaker": "侦探",
        "text": "你把待确认的信息放进了问题里。回答从第一句就不再独立。",
        "voice": "res://assets/audio/dialogue/chapter_03/detective/chapter_03_dispatch_questions_first_02.wav",
        "voice_bus": "Voice"
      }
    ],
    "questions_repeat": [
      {
        "speaker": "侦探",
        "text": "时间先被说出口，记忆才被要求填进去。",
        "voice": "res://assets/audio/dialogue/chapter_03/detective/chapter_03_dispatch_questions_repeat_00.wav",
        "voice_bus": "Voice"
      }
    ],
    "statements_first": [
      {
        "speaker": "侦探",
        "text": "第一版写‘大约四点后’‘灯亮前后’‘车开后一阵’。誊清版把它们全换成 4:17。",
        "voice": "res://assets/audio/dialogue/chapter_03/detective/chapter_03_dispatch_statements_first_00.wav",
        "voice_bus": "Voice"
      },
      {
        "speaker": "黄维国",
        "text": "正式记录需要准确。",
        "voice": "res://assets/audio/dialogue/chapter_03/huang_weiguo/chapter_03_dispatch_statements_first_01.wav",
        "voice_bus": "Voice"
      },
      {
        "speaker": "侦探",
        "text": "把模糊写成精确不叫准确，叫增加原话里没有的信息。",
        "voice": "res://assets/audio/dialogue/chapter_03/detective/chapter_03_dispatch_statements_first_02.wav",
        "voice_bus": "Voice"
      }
    ],
    "statements_repeat": [
      {
        "speaker": "侦探",
        "text": "三种模糊记忆在誊清时才变成同一个分钟。",
        "voice": "res://assets/audio/dialogue/chapter_03/detective/chapter_03_dispatch_statements_repeat_00.wav",
        "voice_bus": "Voice"
      }
    ],
    "waiting_first": [
      {
        "speaker": "罗遥",
        "text": "我们都在候车室等。黄站长指着主钟说四点十七分，邓师傅也重复了。",
        "voice": "res://assets/audio/dialogue/chapter_03/luo_yao/chapter_03_dispatch_waiting_first_00.wav",
        "voice_bus": "Voice"
      },
      {
        "speaker": "邓守义",
        "text": "等轮到我写正式笔录，我已经分不清是自己记得，还是听他们说过。",
        "voice": "res://assets/audio/dialogue/chapter_03/deng_shouyi/chapter_03_dispatch_waiting_first_01.wav",
        "voice_bus": "Voice"
      },
      {
        "speaker": "侦探",
        "text": "共享等待空间让三份证词在落笔前先交换过答案。",
        "voice": "res://assets/audio/dialogue/chapter_03/detective/chapter_03_dispatch_waiting_first_02.wav",
        "voice_bus": "Voice"
      }
    ],
    "waiting_repeat": [
      {
        "speaker": "侦探",
        "text": "证人被分开记录以前，信息并没有被隔离。",
        "voice": "res://assets/audio/dialogue/chapter_03/detective/chapter_03_dispatch_waiting_repeat_00.wav",
        "voice_bus": "Voice"
      }
    ],
    "timeline_locked": [
      {
        "speaker": "侦探",
        "text": "先找到不依赖站内电钟的记录。没有独立锚点，时间线只是另一种猜测。",
        "voice": "res://assets/audio/dialogue/chapter_03/detective/chapter_03_dispatch_timeline_locked_00.wav",
        "voice_bus": "Voice"
      }
    ],
    "timeline_repeat": [
      {
        "speaker": "侦探",
        "text": "03:52、04:40、05:05、08:10。它们只是在记录里共享同一个 4:17。",
        "voice": "res://assets/audio/dialogue/chapter_03/detective/chapter_03_dispatch_timeline_repeat_00.wav",
        "voice_bus": "Voice"
      }
    ],
    "timeline_success": [
      {
        "speaker": "侦探",
        "text": "维护车先离站，之后才复电；照片又在复电后冲印；正式证词直到早上才誊清。",
        "voice": "res://assets/audio/dialogue/chapter_03/detective/chapter_03_dispatch_timeline_success_00.wav",
        "voice_bus": "Voice"
      },
      {
        "speaker": "罗遥",
        "text": "四点十七分没有发生四件事。它只在四种记录之间传递。",
        "voice": "res://assets/audio/dialogue/chapter_03/luo_yao/chapter_03_dispatch_timeline_success_01.wav",
        "voice_bus": "Voice"
      },
      {
        "speaker": "黄维国",
        "text": "即便时间错了，邮袋还是从站里消失。",
        "voice": "res://assets/audio/dialogue/chapter_03/huang_weiguo/chapter_03_dispatch_timeline_success_02.wav",
        "voice_bus": "Voice"
      },
      {
        "speaker": "侦探",
        "text": "那就继续查邮袋为什么离开，以及你为什么需要给它安排一个时间。",
        "voice": "res://assets/audio/dialogue/chapter_03/detective/chapter_03_dispatch_timeline_success_03.wav",
        "voice_bus": "Voice"
      }
    ],
    "raincoat_first": [
      {
        "speaker": "陈默",
        "text": "副钥匙刮到锁簧，是因为我手里抱着雨衣。保险柜封条我碰都没碰。",
        "voice": "res://assets/audio/dialogue/chapter_03/chen_mo/chapter_03_dispatch_raincoat_first_00.wav",
        "voice_bus": "Voice"
      },
      {
        "speaker": "侦探",
        "text": "雨衣内侧是售票室窗帘纤维，外侧后来沾到山路红泥。余真穿着它离开了。",
        "voice": "res://assets/audio/dialogue/chapter_03/detective/chapter_03_dispatch_raincoat_first_01.wav",
        "voice_bus": "Voice"
      }
    ],
    "raincoat_repeat": [
      {
        "speaker": "侦探",
        "text": "陈默进入售票室有痕迹，但痕迹指向帮助，不指向取钱。",
        "voice": "res://assets/audio/dialogue/chapter_03/detective/chapter_03_dispatch_raincoat_repeat_00.wav",
        "voice_bus": "Voice"
      }
    ],
    "clinic_first": [
      {
        "speaker": "罗遥",
        "text": "秦梅诊所四点二十六分收过一名脚伤女子。登记名留空，随身物写的是旧邮袋。",
        "voice": "res://assets/audio/dialogue/chapter_03/luo_yao/chapter_03_dispatch_clinic_first_00.wav",
        "voice_bus": "Voice"
      },
      {
        "speaker": "侦探",
        "text": "这个时间早于复电，来自诊所自己的电池钟与处置顺序。余真没有在站内遇害。",
        "voice": "res://assets/audio/dialogue/chapter_03/detective/chapter_03_dispatch_clinic_first_01.wav",
        "voice_bus": "Voice"
      }
    ],
    "clinic_repeat": [
      {
        "speaker": "侦探",
        "text": "04:26，携邮袋的伤者已经在山路诊所。",
        "voice": "res://assets/audio/dialogue/chapter_03/detective/chapter_03_dispatch_clinic_repeat_00.wav",
        "voice_bus": "Voice"
      }
    ],
    "mailbag_first": [
      {
        "speaker": "陈默",
        "text": "秦梅去世前把袋子交给我。余真留下话：等有人不再把所有名字都当证据，再打开夹层。",
        "voice": "res://assets/audio/dialogue/chapter_03/chen_mo/chapter_03_dispatch_mailbag_first_00.wav",
        "voice_bus": "Voice"
      },
      {
        "speaker": "侦探",
        "text": "工资副本有黄维国签名、站章和兑付号。余真带走的是举报材料。",
        "voice": "res://assets/audio/dialogue/chapter_03/detective/chapter_03_dispatch_mailbag_first_01.wav",
        "voice_bus": "Voice"
      },
      {
        "speaker": "罗遥",
        "text": "还有几封寄往同一旧信箱的信。笔迹完全不同，却画着同一个记号。",
        "voice": "res://assets/audio/dialogue/chapter_03/luo_yao/chapter_03_dispatch_mailbag_first_02.wav",
        "voice_bus": "Voice"
      }
    ],
    "mailbag_repeat": [
      {
        "speaker": "侦探",
        "text": "邮袋夹层同时保存工资证据、不同笔迹的信，以及两份删节过的侦探报告。",
        "voice": "res://assets/audio/dialogue/chapter_03/detective/chapter_03_dispatch_mailbag_repeat_00.wav",
        "voice_bus": "Voice"
      }
    ],
    "pen_first": [
      {
        "speaker": "侦探",
        "text": "三份誊清笔录里的 4:17 都是后加的蓝黑墨水。起笔顿点和你值班笔的分叉划痕一致。",
        "voice": "res://assets/audio/dialogue/chapter_03/detective/chapter_03_dispatch_pen_first_00.wav",
        "voice_bus": "Voice"
      },
      {
        "speaker": "黄维国",
        "text": "我是站长，替他们把时间写清楚有什么问题？",
        "voice": "res://assets/audio/dialogue/chapter_03/huang_weiguo/chapter_03_dispatch_pen_first_01.wav",
        "voice_bus": "Voice"
      },
      {
        "speaker": "侦探",
        "text": "问题是你写进去的时间来自刚刚坏掉的钟，又用它把陈默锁进售票室。",
        "voice": "res://assets/audio/dialogue/chapter_03/detective/chapter_03_dispatch_pen_first_02.wav",
        "voice_bus": "Voice"
      }
    ],
    "pen_repeat": [
      {
        "speaker": "侦探",
        "text": "笔录的统一分钟来自同一支笔，也来自同一个决定。",
        "voice": "res://assets/audio/dialogue/chapter_03/detective/chapter_03_dispatch_pen_repeat_00.wav",
        "voice_bus": "Voice"
      }
    ],
    "deng_first": [
      {
        "speaker": "邓守义",
        "text": "我提前开车让余真没赶上，又为了保住饭碗签了那份笔录。她不是坐我的车跑的。",
        "voice": "res://assets/audio/dialogue/chapter_03/deng_shouyi/chapter_03_dispatch_deng_first_00.wav",
        "voice_bus": "Voice"
      },
      {
        "speaker": "侦探",
        "text": "你的隐瞒造成了空白，但黄维国决定往空白里写什么。",
        "voice": "res://assets/audio/dialogue/chapter_03/detective/chapter_03_dispatch_deng_first_01.wav",
        "voice_bus": "Voice"
      }
    ],
    "deng_repeat": [
      {
        "speaker": "邓守义",
        "text": "纸上那个孔比我勇敢。它十二年都没改口。",
        "voice": "res://assets/audio/dialogue/chapter_03/deng_shouyi/chapter_03_dispatch_deng_repeat_00.wav",
        "voice_bus": "Voice"
      }
    ],
    "huang_first": [
      {
        "speaker": "黄维国",
        "text": "你们现在拿几张烂纸，把当年的应急处置说成阴谋。",
        "voice": "res://assets/audio/dialogue/chapter_03/huang_weiguo/chapter_03_dispatch_huang_first_00.wav",
        "voice_bus": "Voice"
      },
      {
        "speaker": "侦探",
        "text": "不是纸张数量，而是来源关系。你最清楚哪些记录只是抄了你的答案。",
        "voice": "res://assets/audio/dialogue/chapter_03/detective/chapter_03_dispatch_huang_first_01.wav",
        "voice_bus": "Voice"
      }
    ],
    "huang_repeat": [
      {
        "speaker": "黄维国",
        "text": "陈默进门、余真拿袋，这两件事实你推不掉。",
        "voice": "res://assets/audio/dialogue/chapter_03/huang_weiguo/chapter_03_dispatch_huang_repeat_00.wav",
        "voice_bus": "Voice"
      }
    ],
    "d33_not_ready": [
      {
        "speaker": "侦探",
        "text": "还不能把一致等同于污染。我需要校准时间线、诱导问题、两版笔录和证人接触顺序。",
        "voice": "res://assets/audio/dialogue/chapter_03/detective/chapter_03_dispatch_d33_not_ready_00.wav",
        "voice_bus": "Voice"
      }
    ],
    "d33_success": [
      {
        "speaker": "侦探",
        "text": "三份证词先共享错误钟面，再共享你的问题，最后由你誊清成同一个分钟。它们从未独立。",
        "voice": "res://assets/audio/dialogue/chapter_03/detective/chapter_03_dispatch_d33_success_00.wav",
        "voice_bus": "Voice"
      },
      {
        "speaker": "罗遥",
        "text": "我不是在三次回忆里看见 4:17。我是在同一只钟下，把它听了三遍。",
        "voice": "res://assets/audio/dialogue/chapter_03/luo_yao/chapter_03_dispatch_d33_success_01.wav",
        "voice_bus": "Voice"
      },
      {
        "speaker": "黄维国",
        "text": "你证明的只是时间混乱。",
        "voice": "res://assets/audio/dialogue/chapter_03/huang_weiguo/chapter_03_dispatch_d33_success_02.wav",
        "voice_bus": "Voice"
      },
      {
        "speaker": "侦探",
        "text": "所以我还会证明混乱保护了谁。",
        "voice": "res://assets/audio/dialogue/chapter_03/detective/chapter_03_dispatch_d33_success_03.wav",
        "voice_bus": "Voice"
      }
    ],
    "finale_locked": [
      {
        "speaker": "侦探",
        "text": "时间诡计已经拆开，但还要找齐余真的去向、邮袋内容、陈默进入的目的和笔录改写者。",
        "voice": "res://assets/audio/dialogue/chapter_03/detective/chapter_03_dispatch_finale_locked_00.wav",
        "voice_bus": "Voice"
      }
    ],
    "return_ticket": [
      {
        "speaker": "罗遥",
        "text": "暗房和售票账还在原处。",
        "voice": "res://assets/audio/dialogue/chapter_03/luo_yao/chapter_03_dispatch_return_ticket_00.wav",
        "voice_bus": "Voice"
      }
    ],
    "enter_finale": [
      {
        "speaker": "陈默",
        "text": "十二年了。别替我说我从没进去过，只说清楚我进去做了什么。",
        "voice": "res://assets/audio/dialogue/chapter_03/chen_mo/chapter_03_dispatch_enter_finale_00.wav",
        "voice_bus": "Voice"
      }
    ]
  }
}
