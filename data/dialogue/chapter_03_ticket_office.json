{
  "conversations": {
    "intro": [
      {
        "speaker": "旁白",
        "text": "暗房的红灯早已熄灭。墙钟与背印机之间那根短线，却仍完整地钉在墙上。",
        "voice": "res://assets/audio/dialogue/chapter_03/narrator/chapter_03_ticket_office_intro_00.wav",
        "voice_bus": "Voice"
      },
      {
        "speaker": "罗遥",
        "text": "我在这里冲了那卷巡检照片。旧报告把背印当成快门时间，我也签了字。",
        "voice": "res://assets/audio/dialogue/chapter_03/luo_yao/chapter_03_ticket_office_intro_01.wav",
        "voice_bus": "Voice"
      },
      {
        "speaker": "侦探",
        "text": "签字不是终点。先把曝光、显影和背印分开。",
        "voice": "res://assets/audio/dialogue/chapter_03/detective/chapter_03_ticket_office_intro_02.wav",
        "voice_bus": "Voice"
      }
    ],
    "negative_first": [
      {
        "speaker": "侦探",
        "text": "第十格是配电室，第十一格是走廊，第十二格才是保险箱。巡检表把这段连续顺序记在三点三十四分。",
        "voice": "res://assets/audio/dialogue/chapter_03/detective/chapter_03_ticket_office_negative_first_00.wav",
        "voice_bus": "Voice"
      },
      {
        "speaker": "罗遥",
        "text": "没有剪口，也没有重新装卷。保险箱照片不可能突然跳到复电以后拍摄。",
        "voice": "res://assets/audio/dialogue/chapter_03/luo_yao/chapter_03_ticket_office_negative_first_01.wav",
        "voice_bus": "Voice"
      }
    ],
    "negative_repeat": [
      {
        "speaker": "侦探",
        "text": "底片顺序把曝光留在 03:34 左右。",
        "voice": "res://assets/audio/dialogue/chapter_03/detective/chapter_03_ticket_office_negative_repeat_00.wav",
        "voice_bus": "Voice"
      }
    ],
    "batch_first": [
      {
        "speaker": "罗遥",
        "text": "停电时显影机不能用。批次单写着五点零五分开机，整卷一起处理。",
        "voice": "res://assets/audio/dialogue/chapter_03/luo_yao/chapter_03_ticket_office_batch_first_00.wav",
        "voice_bus": "Voice"
      },
      {
        "speaker": "侦探",
        "text": "这给了照片另一个时刻：不是拍下它，而是处理它。",
        "voice": "res://assets/audio/dialogue/chapter_03/detective/chapter_03_ticket_office_batch_first_01.wav",
        "voice_bus": "Voice"
      }
    ],
    "batch_repeat": [
      {
        "speaker": "侦探",
        "text": "冲印发生在复电之后，晚于照片曝光。",
        "voice": "res://assets/audio/dialogue/chapter_03/detective/chapter_03_ticket_office_batch_repeat_00.wav",
        "voice_bus": "Voice"
      }
    ],
    "printer_first": [
      {
        "speaker": "侦探",
        "text": "背印机没有连接相机。它在相纸通过时，从暗房墙钟读取数字。",
        "voice": "res://assets/audio/dialogue/chapter_03/detective/chapter_03_ticket_office_printer_first_00.wav",
        "voice_bus": "Voice"
      },
      {
        "speaker": "罗遥",
        "text": "而暗房墙钟刚被控制箱拨回四点十七分。是我把错误印到了照片背面。",
        "voice": "res://assets/audio/dialogue/chapter_03/luo_yao/chapter_03_ticket_office_printer_first_01.wav",
        "voice_bus": "Voice"
      }
    ],
    "printer_repeat": [
      {
        "speaker": "侦探",
        "text": "4:17 属于冲印设备读到的钟面，不属于快门。",
        "voice": "res://assets/audio/dialogue/chapter_03/detective/chapter_03_ticket_office_printer_repeat_00.wav",
        "voice_bus": "Voice"
      }
    ],
    "ledger_first": [
      {
        "speaker": "侦探",
        "text": "上页被撕了，但圆珠笔压痕还在：三名临时工的工资由黄维国代领，余真在兑付号旁逐个画了圈。",
        "voice": "res://assets/audio/dialogue/chapter_03/detective/chapter_03_ticket_office_ledger_first_00.wav",
        "voice_bus": "Voice"
      },
      {
        "speaker": "罗遥",
        "text": "她失踪前说账不平。我以为她只是想把责任推开。",
        "voice": "res://assets/audio/dialogue/chapter_03/luo_yao/chapter_03_ticket_office_ledger_first_01.wav",
        "voice_bus": "Voice"
      },
      {
        "speaker": "侦探",
        "text": "这张压痕给了她带走账目副本的理由。",
        "voice": "res://assets/audio/dialogue/chapter_03/detective/chapter_03_ticket_office_ledger_first_02.wav",
        "voice_bus": "Voice"
      }
    ],
    "ledger_repeat": [
      {
        "speaker": "侦探",
        "text": "被撕掉的纸没有带走下一页留下的压力。",
        "voice": "res://assets/audio/dialogue/chapter_03/detective/chapter_03_ticket_office_ledger_repeat_00.wav",
        "voice_bus": "Voice"
      }
    ],
    "d32_not_ready": [
      {
        "speaker": "侦探",
        "text": "我还需要底片顺序、冲印批次和背印机来源，才能把三个时刻拆开。",
        "voice": "res://assets/audio/dialogue/chapter_03/detective/chapter_03_ticket_office_d32_not_ready_00.wav",
        "voice_bus": "Voice"
      }
    ],
    "d32_success": [
      {
        "speaker": "侦探",
        "text": "照片在 03:34 左右曝光，05:05 才冲印。背面的 4:17 只是暗房子钟的错误读数。",
        "voice": "res://assets/audio/dialogue/chapter_03/detective/chapter_03_ticket_office_d32_success_00.wav",
        "voice_bus": "Voice"
      },
      {
        "speaker": "罗遥",
        "text": "旧案把处理时间当成拍摄时间，再拿照片去证明那只钟。",
        "voice": "res://assets/audio/dialogue/chapter_03/luo_yao/chapter_03_ticket_office_d32_success_01.wav",
        "voice_bus": "Voice"
      },
      {
        "speaker": "侦探",
        "text": "一个错误绕了一圈，回来给自己作证。调度室应该还有不靠这套电钟的记录。",
        "voice": "res://assets/audio/dialogue/chapter_03/detective/chapter_03_ticket_office_d32_success_02.wav",
        "voice_bus": "Voice"
      }
    ],
    "return_concourse": [
      {
        "speaker": "罗遥",
        "text": "站厅的控制箱还开着，回去就能再查。",
        "voice": "res://assets/audio/dialogue/chapter_03/luo_yao/chapter_03_ticket_office_return_concourse_00.wav",
        "voice_bus": "Voice"
      }
    ],
    "dispatch_locked": [
      {
        "speaker": "侦探",
        "text": "先证明照片背印形成于冲印，而不是曝光。否则新时间线没有可靠起点。",
        "voice": "res://assets/audio/dialogue/chapter_03/detective/chapter_03_ticket_office_dispatch_locked_00.wav",
        "voice_bus": "Voice"
      }
    ],
    "enter_dispatch": [
      {
        "speaker": "罗遥",
        "text": "邓师傅把当年的路单带来了。他说那张纸比他的记忆可靠。",
        "voice": "res://assets/audio/dialogue/chapter_03/luo_yao/chapter_03_ticket_office_enter_dispatch_00.wav",
        "voice_bus": "Voice"
      }
    ]
  }
}
